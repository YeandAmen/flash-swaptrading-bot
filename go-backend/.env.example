# Export these variables in your shell or service configuration.
# The Go backend does not automatically load .env files.
RPC_URL=https://your-ethereum-mainnet-rpc.example
ALLOW_LIVE_TRADING=off
GO_LISTEN=127.0.0.1:7780
SCAN_INTERVAL=15s
# USDC, WBTC and LINK by default; at most 20 unique token addresses.
SCAN_TOKENS=0xA0b86991c6218b36c1d19D4a2e9Eb0cE3606eB48,0x2260FAC5E5542a773Aa44fBCfeDf7C193bc2C599,0x514910771AF9Ca656af840dff83E8264EcF986CA
LOAN_SIZES_WEI=10000000000000000,100000000000000000,1000000000000000000
GAS_BUDGET_UNITS=600000
PRIORITY_FEE_WEI=2000000000
MIN_NET_WEI=1000000000000000
QUOTE_BUFFER_BPS=50
# Optional: both required for eth_call simulations against an existing proxy.
# Only the retained proxy and Logic V4 runtimes are accepted by this release.
FLASH_ARB_PROXY=
FLASH_ARB_OWNER=
# Live mode is off by default and starts disarmed even when enabled.
# Existing encrypted Ethereum V3 keystore and owner-only password file.
WALLET_KEYSTORE_FILE=
WALLET_PASSWORD_FILE=
GO_DATA_DIR=data/go-live
SEND_RPC_URL=https://rpc.flashbots.net/fast
# All four limits are REQUIRED positive integer wei values when live is on.
# No spending defaults are supplied. Select limits before enabling.
LIVE_MAX_GAS_WEI=
LIVE_DAILY_GAS_WEI=
LIVE_MAX_PRINCIPAL_WEI=
LIVE_MAX_FEE_PER_GAS_WEI=
LIVE_CONFIRMATIONS=3
# Optional analyst; paid calls happen only when you click Analyze.
OPENROUTER_MODEL=deepseek/deepseek-chat-v3-0324
OPENROUTER_API_KEY_FILE=
# Alternative: OPENROUTER_API_KEY supplied through your secret manager.
