# Copy to .env and set the read RPC to an Ethereum mainnet provider.
# Full history backfill needs archive eth_call and safety simulations need state overrides.
RPC_URL=

# Enable signing deliberately, then use the dashboard to confirm deployment or arm trading.
ALLOW_LIVE_TRADING=off
# Absolute USD ceiling on a swap network fee. Lower chain-specific and daily limits still apply.
MAX_SWAP_NETWORK_FEE_USD=5
# Restore explicitly armed Ethereum modes on restart after readiness checks.
ETHEREUM_AUTO_ARM=off
SEND_RPC_URL=https://rpc.flashbots.net/fast
MEV=on
# all also checks the Ethereum token lists in the background. spot uses the spot/core universe.
MEV_UNIVERSE=all
MEV_MAX_TRACKED_POOLS=480
# Flash funding modes are auto, pool, aave, morpho, balancer, and spark. Spark requires a compatible FlashArb proxy release.
MEV_FUNDING=auto
# bundle uses private builders. direct signs ordinary Ethereum transactions through RPC_URL.
MEV_SUBMISSION=bundle
# Ethereum and Arbitrum principal limit in USD. Set to unlimited to size against lender liquidity.
MEV_MAX_LOAN_USD=1000000
# MEV_DIRECT_CADENCE_MAX_ROUTES=8
# Set both gas caps above zero and explicitly arm to allow direct transactions.
MEV_DIRECT_MAX_GAS_USD=0
MEV_DIRECT_DAILY_GAS_USD=0
# MEV_DIRECT_PREMIUM_MAX_GAS_USD=20
# Optional priority fee increase for high-profit private orders, in percent (0..25, default 0).
# MEV_DIRECT_PREMIUM_TIP_BUMP_PCT=0
# MEV_DIRECT_PROTECTED=on
# Eligible blocks for an ordinary private Ethereum order (1..3). Default 3.
# MEV_DIRECT_PROTECTED_BLOCKS=3
# MEV_DIRECT_MIN_NET_USD=0.05
# MEV_DIRECT_MAX_PRIORITY_GWEI=0.25
# Optional comma-separated HTTPS RPCs that receive the same signed public transaction.
# MEV_DIRECT_BROADCAST_RPC_URLS=
# Optional live policy after 30 minutes without a confirmed MEV landing.
# MEV_IDLE_MIN_NET_USD=0.01
# MEV_IDLE_BUILDER_TIP_PCT=0.80
# MEV_IDLE_GAS_PADDING_PCT=0.15
# Optional legacy contract owned by the bot wallet. The dashboard saves new proxy deployments automatically.
# MEV_V2_CONTRACT_ADDRESS=0x...
# Set only one FlashArb address.
# MEV_V3_CONTRACT_ADDRESS=0x...

# Local dashboard and paper trading settings.
PORT=7777
# DATA_DIR=data
# WALLET_KEY_FILE=/absolute/path/to/protected/wallet.key
PAPER_START_USD=50
TOKEN_MODE=all
ML_MODE=auto

# Optional extra networks. Signing is independently gated on Arbitrum.
ARBITRUM=off
ARBITRUM_LIVE=off
# ARBITRUM_RPC_URL=https://arb1.arbitrum.io/rpc
# ARBITRUM_OWNER_ADDRESS=0x...
# ARBITRUM_EXECUTOR_ADDRESS=0x...
# ARBITRUM_DEPLOYMENT_TX=0x...
# ARBITRUM_RELEASE_HASH=0x...  # Keep the currently approved Arbitrum proxy release while preparing an upgrade.
SOLANA=off
SOLANA_LIVE=off
# Shorter interval between healthy automatic scans, subject to Jupiter's rate limits.
SOLANA_FAST_SCAN=off
# Regular scan limit in USDC. Set to unlimited to size against the Kamino reserve.
# SOLANA_LOAN_USDC=250
# SOLANA_WALLET_KEY_FILE=/absolute/path/to/owner-only-solana-keypair.json
# SOLANA_WALLET_ADDRESS=
# SOLANA_RPC_URL=https://api.mainnet-beta.solana.com
# JUPITER_API_KEY=
